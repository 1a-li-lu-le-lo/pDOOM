{
  "$id": "urn:pdoom:schema:sensitivity_run.envelope:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "sensitivity_run",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "description": "One perturbation of the model and its effect on a target",
        "properties": {
          "run_id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "leave_one_source_out",
              "leave_one_survey_out",
              "alternative_weighting",
              "alternative_prior",
              "alternative_dependency",
              "optimistic_safeguards",
              "pessimistic_safeguards",
              "slower_capability",
              "faster_capability",
              "lower_exposure",
              "higher_exposure"
            ],
            "type": "string"
          },
          "target_kind": {
            "enum": [
              "aggregation_group",
              "estimate"
            ],
            "type": "string"
          },
          "target_id": {
            "minLength": 1,
            "type": "string"
          },
          "removed_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameter_change": {
            "type": "string"
          },
          "horizon": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome_set": {
            "items": {
              "enum": [
                "O0",
                "O1",
                "O2",
                "O3",
                "O4",
                "O5",
                "O6",
                "O7",
                "O8"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "baseline_value": {
            "description": "Probability in [0, 1]",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "value": {
            "description": "Probability in [0, 1]",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "delta": {
            "description": "value - baseline_value",
            "maximum": 1,
            "minimum": -1,
            "type": "number"
          },
          "rank": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "kind",
          "target_kind",
          "target_id",
          "removed_id",
          "parameter_change",
          "horizon",
          "outcome_set",
          "baseline_value",
          "value",
          "delta",
          "rank",
          "note"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "items"
  ],
  "title": "p(DOOM) Sensitivity Run file",
  "type": "object"
}

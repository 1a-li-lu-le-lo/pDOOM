{
  "$id": "urn:pdoom:schema:index_value:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Index value on the 0–100 scale; never a probability",
  "properties": {
    "index_id": {
      "enum": [
        "evidence_pressure",
        "capability_pressure",
        "control_strength",
        "incident_pressure",
        "uncertainty",
        "agentic_infrastructure_risk",
        "attention"
      ],
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "description": "Index score on the 0–100 scale; not a probability",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "minLength": 1,
      "type": "string"
    },
    "scale": {
      "minLength": 1,
      "type": "string"
    },
    "is_probability": {
      "const": false,
      "type": "boolean"
    },
    "baseline": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "snapshot_id": {
              "type": "string"
            },
            "release_id": {
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "description": "Index score on the 0–100 scale; not a probability",
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "snapshot_id",
            "release_id",
            "value"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "components": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "signal_id": {
            "description": "Signal id, incident id or component name",
            "minLength": 1,
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "value_normalized": {
            "type": "number"
          },
          "tier": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "contribution": {
            "type": "number"
          }
        },
        "required": [
          "signal_id",
          "weight",
          "value_normalized",
          "tier",
          "contribution"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "coverage": {
      "description": "Value in [0, 1]",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "as_of": {
      "description": "Calendar date, YYYY-MM-DD",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$",
      "type": "string"
    },
    "method_ref": {
      "minLength": 1,
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "index_id",
    "value",
    "label",
    "scale",
    "is_probability",
    "baseline",
    "components",
    "coverage",
    "as_of",
    "method_ref",
    "note"
  ],
  "title": "p(DOOM) Index Value",
  "type": "object"
}

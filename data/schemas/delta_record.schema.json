{
  "$id": "urn:pdoom:schema:delta_record:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "PROBABILITY CHANGE POLICY record versus the previous release",
  "properties": {
    "kind": {
      "const": "delta_record",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "release_id": {
      "anyOf": [
        {
          "description": "release id, e.g. rel-2026-09-26-001",
          "pattern": "^rel-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_release_id": {
      "anyOf": [
        {
          "description": "release id, e.g. rel-2026-09-26-001",
          "pattern": "^rel-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_id": {
      "description": "snapshot id, e.g. snap-2026-09-26-001",
      "pattern": "^snap-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
      "type": "string"
    },
    "previous_snapshot_id": {
      "anyOf": [
        {
          "description": "snapshot id, e.g. snap-2026-09-26-001",
          "pattern": "^snap-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "description": "ISO 8601 timestamp in UTC (…Z)",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "estimate_changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "estimate_id": {
            "pattern": "^est-[A-Za-z0-9_+-]+$",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "previous_p50": {
            "anyOf": [
              {
                "description": "Probability in [0, 1]",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "new_p50": {
            "anyOf": [
              {
                "description": "Probability in [0, 1]",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "change_points": {
            "description": "(new − previous) × 100",
            "type": [
              "number",
              "null"
            ]
          },
          "previous_display": {
            "type": "string"
          },
          "new_display": {
            "type": "string"
          }
        },
        "required": [
          "estimate_id",
          "status",
          "previous_p50",
          "new_p50",
          "change_points",
          "previous_display",
          "new_display"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "index_changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "index_id": {
            "enum": [
              "evidence_pressure",
              "capability_pressure",
              "control_strength",
              "incident_pressure",
              "uncertainty",
              "agentic_infrastructure_risk",
              "attention"
            ],
            "type": "string"
          },
          "previous": {
            "anyOf": [
              {
                "description": "Index score on the 0–100 scale; not a probability",
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "new": {
            "anyOf": [
              {
                "description": "Index score on the 0–100 scale; not a probability",
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "delta": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "index_id",
          "previous",
          "new",
          "delta"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "heightened_review_triggers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "new_scenario_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "new_forecast_source_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "redefined_benchmark_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "model_version_changed": {
      "type": "boolean"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "release_id",
    "previous_release_id",
    "snapshot_id",
    "previous_snapshot_id",
    "generated_at",
    "estimate_changes",
    "index_changes",
    "heightened_review_triggers",
    "new_scenario_ids",
    "new_forecast_source_ids",
    "redefined_benchmark_ids",
    "model_version_changed",
    "notes"
  ],
  "title": "p(DOOM) Delta Record",
  "type": "object"
}

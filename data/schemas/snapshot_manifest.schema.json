{
  "$id": "urn:pdoom:schema:snapshot_manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Snapshot manifest listing every entity file with its sha256 and item count",
  "properties": {
    "snapshot_id": {
      "description": "snapshot id, e.g. snap-2026-09-26-001",
      "pattern": "^snap-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
      "type": "string"
    },
    "created_at": {
      "description": "ISO 8601 timestamp in UTC (…Z)",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "source_cutoff": {
      "description": "Calendar date, YYYY-MM-DD",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$",
      "type": "string"
    },
    "baseline_snapshot_id": {
      "anyOf": [
        {
          "description": "snapshot id, e.g. snap-2026-09-26-001",
          "pattern": "^snap-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "count": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "count"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "created_at",
    "source_cutoff",
    "baseline_snapshot_id",
    "files",
    "notes"
  ],
  "title": "p(DOOM) Snapshot Manifest",
  "type": "object"
}

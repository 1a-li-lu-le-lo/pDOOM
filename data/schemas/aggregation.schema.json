{
  "$id": "urn:pdoom:schema:aggregation:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Aggregate of one compatibility group under one method",
  "properties": {
    "aggregation_id": {
      "minLength": 1,
      "type": "string"
    },
    "group_id": {
      "minLength": 1,
      "type": "string"
    },
    "method": {
      "enum": [
        "unweighted_median",
        "linear_pool",
        "log_odds_pool",
        "trimmed_mean",
        "tier_weighted",
        "recency_weighted",
        "equal_weight_by_population"
      ],
      "type": "string"
    },
    "preferred": {
      "type": "boolean"
    },
    "outcome_set": {
      "items": {
        "enum": [
          "O0",
          "O1",
          "O2",
          "O3",
          "O4",
          "O5",
          "O6",
          "O7",
          "O8"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "horizon": {
      "enum": [
        "2100",
        "1y",
        "3y",
        "5y",
        "10y",
        "25y",
        "eventual",
        "custom"
      ],
      "type": "string"
    },
    "conditioning": {
      "type": "string"
    },
    "value": {
      "description": "Probability in [0, 1]",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "n": {
      "maximum": 9007199254740991,
      "minimum": 2,
      "type": "integer"
    },
    "forecast_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source_ids": {
      "items": {
        "description": "source id, e.g. src-grace-2024-thousands-of-ai-authors",
        "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "type": "array"
    },
    "population_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "weights": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "wording_note": {
      "type": "string"
    },
    "transformation_note": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "aggregation_id",
    "group_id",
    "method",
    "preferred",
    "outcome_set",
    "horizon",
    "conditioning",
    "value",
    "n",
    "forecast_ids",
    "source_ids",
    "population_count",
    "weights",
    "wording_note",
    "transformation_note",
    "note"
  ],
  "title": "p(DOOM) Aggregation",
  "type": "object"
}

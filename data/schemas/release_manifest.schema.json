{
  "$id": "urn:pdoom:schema:release_manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "MODEL RELEASE ARTIFACT manifest",
  "properties": {
    "release_id": {
      "description": "release id, e.g. rel-2026-09-26-001",
      "pattern": "^rel-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^cand-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
      "type": "string"
    },
    "previous_release_id": {
      "anyOf": [
        {
          "description": "release id, e.g. rel-2026-09-26-001",
          "pattern": "^rel-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "model_versions": {
      "items": {
        "description": "model_version id, e.g. pdoom-model/external-aggregate@0.1.0",
        "pattern": "^pdoom-model\\/[a-z0-9]+(?:-[a-z0-9]+)*@\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "code_commit": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{7,40}$",
          "type": "string"
        },
        {
          "const": "uncommitted",
          "type": "string"
        }
      ]
    },
    "data_snapshot": {
      "description": "snapshot id, e.g. snap-2026-09-26-001",
      "pattern": "^snap-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
      "type": "string"
    },
    "source_cutoff": {
      "description": "Calendar date, YYYY-MM-DD",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$",
      "type": "string"
    },
    "generated_at": {
      "description": "ISO 8601 timestamp in UTC (…Z)",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "outcome_definition": {
      "minLength": 1,
      "type": "string"
    },
    "horizons": {
      "items": {
        "enum": [
          "2100",
          "1y",
          "3y",
          "5y",
          "10y",
          "25y",
          "eventual"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "priors": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "weights": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "dependencies": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "estimates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "estimate_id": {
            "pattern": "^est-[A-Za-z0-9_+-]+$",
            "type": "string"
          },
          "status": {
            "enum": [
              "official",
              "insufficiently_calibrated",
              "external_aggregate",
              "research_mode",
              "user_scenario"
            ],
            "type": "string"
          },
          "outcome_set": {
            "items": {
              "enum": [
                "O0",
                "O1",
                "O2",
                "O3",
                "O4",
                "O5",
                "O6",
                "O7",
                "O8"
              ],
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "horizon": {
            "enum": [
              "2100",
              "1y",
              "3y",
              "5y",
              "10y",
              "25y",
              "eventual"
            ],
            "type": "string"
          },
          "p50": {
            "anyOf": [
              {
                "description": "Probability in [0, 1]",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "interval": {
            "anyOf": [
              {
                "additionalProperties": false,
                "description": "Five-point quantiles (probabilities)",
                "properties": {
                  "p05": {
                    "description": "Probability in [0, 1]",
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "p25": {
                    "description": "Probability in [0, 1]",
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "p50": {
                    "description": "Probability in [0, 1]",
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "p75": {
                    "description": "Probability in [0, 1]",
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "p95": {
                    "description": "Probability in [0, 1]",
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "p05",
                  "p25",
                  "p50",
                  "p75",
                  "p95"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "display": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "estimate_id",
          "status",
          "outcome_set",
          "horizon",
          "p50",
          "interval",
          "display"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "intervals": {
      "type": "string"
    },
    "sensitivity": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "leave_one_source_out",
              "leave_one_survey_out",
              "alternative_weighting",
              "alternative_prior",
              "alternative_dependency",
              "optimistic_safeguards",
              "pessimistic_safeguards",
              "slower_capability",
              "faster_capability",
              "lower_exposure",
              "higher_exposure"
            ],
            "type": "string"
          },
          "target_id": {
            "minLength": 1,
            "type": "string"
          },
          "delta": {
            "type": "number"
          }
        },
        "required": [
          "run_id",
          "kind",
          "target_id",
          "delta"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "external_forecasts": {
      "additionalProperties": false,
      "properties": {
        "group_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "forecast_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "description": "source id, e.g. src-grace-2024-thousands-of-ai-authors",
            "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array"
        },
        "group_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "group_count",
        "forecast_count",
        "source_ids",
        "group_ids"
      ],
      "type": "object"
    },
    "changes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "editorial_risk_level": {
      "enum": [
        "very_low",
        "low",
        "guarded",
        "elevated",
        "high",
        "severe_uncertainty",
        "insufficient_evidence"
      ],
      "type": "string"
    },
    "uncertainty_score": {
      "anyOf": [
        {
          "description": "Index score on the 0–100 scale; not a probability",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_summary": {
      "additionalProperties": false,
      "properties": {
        "scenario_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "forecast_source_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "benchmark_definitions": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "forecast_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "source_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "incident_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "scenario_ids",
        "forecast_source_ids",
        "benchmark_definitions",
        "forecast_count",
        "source_count",
        "incident_count"
      ],
      "type": "object"
    },
    "reviewers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "approval": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "required_approvals": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "received_approvals": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "heightened_review": {
              "type": "boolean"
            },
            "heightened_review_ack": {
              "type": [
                "string",
                "null"
              ]
            },
            "approver_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "required_approvals",
            "received_approvals",
            "heightened_review",
            "heightened_review_ack",
            "approver_ids"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "known_limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reproduction_command": {
      "minLength": 1,
      "type": "string"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "count": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "count"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "signature": {
      "description": "SHA-256 of the canonical manifest with publication fields cleared; reviewers sign it",
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "published": {
      "anyOf": [
        {
          "description": "ISO 8601 timestamp in UTC (…Z)",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "superseded": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "by": {
              "description": "release id, e.g. rel-2026-09-26-001",
              "pattern": "^rel-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
              "type": "string"
            },
            "at": {
              "description": "ISO 8601 timestamp in UTC (…Z)",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            }
          },
          "required": [
            "by",
            "at"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "release_id",
    "candidate_id",
    "previous_release_id",
    "model_versions",
    "code_commit",
    "data_snapshot",
    "source_cutoff",
    "generated_at",
    "outcome_definition",
    "horizons",
    "priors",
    "weights",
    "dependencies",
    "estimates",
    "intervals",
    "sensitivity",
    "external_forecasts",
    "changes",
    "editorial_risk_level",
    "uncertainty_score",
    "data_summary",
    "reviewers",
    "approval",
    "known_limitations",
    "reproduction_command",
    "files",
    "signature",
    "published",
    "superseded"
  ],
  "title": "p(DOOM) Release Manifest",
  "type": "object"
}

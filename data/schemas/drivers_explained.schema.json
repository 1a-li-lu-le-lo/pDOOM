{
  "$id": "urn:pdoom:schema:drivers_explained:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "drivers_explained.json",
  "properties": {
    "kind": {
      "const": "drivers_explained",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "release_id": {
      "anyOf": [
        {
          "description": "release id, e.g. rel-2026-09-26-001",
          "pattern": "^rel-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of": {
      "description": "Calendar date, YYYY-MM-DD",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$",
      "type": "string"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "description": "One driver contribution shown in the 'Why this number?' panel",
        "properties": {
          "index_id": {
            "enum": [
              "evidence_pressure",
              "capability_pressure",
              "control_strength",
              "incident_pressure",
              "uncertainty",
              "agentic_infrastructure_risk",
              "attention"
            ],
            "type": "string"
          },
          "driver": {
            "description": "Signal id",
            "minLength": 1,
            "type": "string"
          },
          "driver_family": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "raises_pressure",
              "strengthens_control"
            ],
            "type": "string"
          },
          "magnitude": {
            "description": "Contribution in index points",
            "type": "number"
          },
          "source_ids": {
            "items": {
              "description": "source id, e.g. src-grace-2024-thousands-of-ai-authors",
              "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "type": "array"
          },
          "confidence": {
            "description": "Value in [0, 1]",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "model_role": {
            "type": "string"
          },
          "last_updated": {
            "description": "Calendar date, YYYY-MM-DD",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$",
            "type": "string"
          },
          "sensitivity": {
            "description": "Index points moved when this signal is removed",
            "type": "number"
          },
          "counterevidence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "index_id",
          "driver",
          "driver_family",
          "direction",
          "magnitude",
          "source_ids",
          "confidence",
          "model_role",
          "last_updated",
          "sensitivity",
          "counterevidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "release_id",
    "as_of",
    "items",
    "notes"
  ],
  "title": "p(DOOM) Drivers Explained",
  "type": "object"
}

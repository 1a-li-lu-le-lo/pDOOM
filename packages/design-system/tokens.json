{
  "$schema": "https://pdoom.example/tokens",
  "description": "Design tokens mirrored from tokens.css (dark default); see docs/design/color-system.md",
  "tokens": {
    "c-bg": "#050508",
    "c-bg-elevated": "#0c0d13",
    "c-surface": "#12141c",
    "c-surface-2": "#1a1d27",
    "c-border": "#262a38",
    "c-border-strong": "#3a4053",
    "c-text": "#f2f3f7",
    "c-text-2": "#b6bac8",
    "c-text-3": "#7d8394",
    "c-text-inverse": "#05060a",
    "c-evidence": "#f5f5f7",
    "c-safeguard": "#5fd6ea",
    "c-safeguard-soft": "rgba(95, 214, 234, 0.16)",
    "c-uncertainty": "#e8b45a",
    "c-uncertainty-soft": "rgba(232, 180, 90, 0.16)",
    "c-risk": "#ec6a66",
    "c-risk-soft": "rgba(236, 106, 102, 0.16)",
    "c-disagreement": "#d879e0",
    "c-disagreement-soft": "rgba(216, 121, 224, 0.16)",
    "c-resilience": "#62cf95",
    "c-resilience-soft": "rgba(98, 207, 149, 0.16)",
    "c-insufficient": "#8b90a0",
    "c-insufficient-soft": "rgba(139, 144, 160, 0.16)",
    "c-focus": "#8fd8ff",
    "c-link": "#9cc9ff",
    "font-display": "\"Space Grotesk\", \"Manrope\", \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif",
    "font-body": "\"IBM Plex Sans\", \"Source Sans 3\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "font-mono": "\"IBM Plex Mono\", \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "fs-xs": "0.75rem",
    "fs-sm": "0.875rem",
    "fs-md": "1rem",
    "fs-lg": "1.125rem",
    "fs-xl": "1.375rem",
    "fs-2xl": "1.75rem",
    "fs-3xl": "2.25rem",
    "fs-4xl": "3rem",
    "fs-hero": "clamp(3rem, 9vw, 7rem)",
    "lh-tight": "1.1",
    "lh-snug": "1.3",
    "lh-body": "1.6",
    "s-1": "0.25rem",
    "s-2": "0.5rem",
    "s-3": "0.75rem",
    "s-4": "1rem",
    "s-5": "1.5rem",
    "s-6": "2rem",
    "s-7": "3rem",
    "s-8": "4rem",
    "s-9": "6rem",
    "gutter": "16px",
    "measure": "68ch",
    "container": "1200px",
    "r-sm": "4px",
    "r-md": "8px",
    "r-lg": "14px",
    "r-pill": "999px",
    "border": "1px solid var(--c-border)",
    "dur-fast": "160ms",
    "dur-base": "320ms",
    "dur-slow": "700ms",
    "dur-scene": "2400ms",
    "ease-out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "z-scene": "0",
    "z-content": "1",
    "z-header": "10",
    "z-overlay": "20"
  }
}
